# The podman network the searxng-mcp stack and these crypto MCP servers
# share with bitcoind, monerod, monero-wallet-rpc and lightningd. Vendored
# here (rather than left only on the host) so a fresh checkout has it.
# deploy/install.sh symlinks this into ~/.config/containers/systemd/, but
# only when no other repo has already provided it.
[Network]
NetworkName=npm-network
